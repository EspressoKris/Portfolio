---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CellMap from '../components/CellMap.astro';
import PubCard from '../components/PubCard.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { profile, links, positions, education, awards, research } from '../data/profile';
import { url } from '../lib/url';
import profileImg from '../assets/profile.jpeg';

const pubs = (await getCollection('publications')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = pubs.filter((p) => p.data.featured);
const firstAuthor = pubs.filter((p) => p.data.role === 'First author').length;
const tutorials = (await getCollection('docs')).filter((d) => d.id.startsWith('tutorials/')).sort((a, b) => b.id.split('/').length - a.id.split('/').length);
---
<Base>
  <section class="hero container">
    <div class="hero__intro">
      <div class="hero__person">
        <Image src={profileImg} alt={profile.name} width={96} height={96} class="hero__photo" loading="eager" />
        <div>
          <p class="hero__name">{profile.title}</p>
          <p class="hero__role">{profile.role} · {profile.employer}</p>
        </div>
      </div>

      <p class="eyebrow">Computational biology · Haemato-oncology</p>
      <h1 class="hero__title serif">
        I use single-cell and multi-omic data to understand how myeloid leukaemias evolve and respond to treatment.
      </h1>
      <p class="hero__lead">
        I'm a postdoctoral computational biologist at the
        <a href="https://www.imm.ox.ac.uk/">MRC Weatherall Institute of Molecular Medicine</a>, University of Oxford.
        I trained first as a wet-lab scientist in leukaemia stem cell biology, then moved into computational work during
        my PhD at the Cancer Research UK Manchester Institute.
      </p>

      <ul class="highlights">
        <li><strong>{pubs.length}</strong> peer-reviewed papers</li>
        <li><strong>{firstAuthor}</strong> first-author</li>
        <li>{awards[0].title} {awards[0].dates}</li>
      </ul>

      <ul class="hero__links" aria-label="Profiles">
        {links.map((l) => (
          <li><a href={l.href} aria-label={l.label} title={l.label}><Icon name={l.icon} size="20" /></a></li>
        ))}
      </ul>
    </div>

    <div class="hero__visual">
      <CellMap />
    </div>
  </section>

  <section class="section container reveal" aria-labelledby="research">
    <h2 class="section-title" id="research">Research</h2>
    <div class="research-grid">
      {research.map((r) => (
        <div class="research-card">
          <span class="research-card__icon"><Icon name={r.icon} size="22" /></span>
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container reveal" aria-labelledby="selected">
    <h2 class="section-title" id="selected">
      Selected publications
      <a href={url('publications/')}>All {pubs.length} papers →</a>
    </h2>
    <div class="pub-list">
      {featured.map((p) => <PubCard pub={p} />)}
    </div>
  </section>

  <section class="section container reveal" aria-labelledby="tutorials">
    <div class="tutorials-band">
      <div>
        <p class="eyebrow">Tutorials</p>
        <h2 id="tutorials" class="tutorials-band__title">Hands-on bioinformatics, start to finish</h2>
        <p>Step-by-step guides for bulk and single-cell RNA-seq, written for people who want to run the analysis themselves.</p>
        <a class="btn" href={url('tutorials/')}><Icon name="book" /> Browse tutorials</a>
      </div>
      <ul class="tutorials-band__list">
        {tutorials.slice(0, 4).map((t) => (
          <li><a href={url(`${t.id}/`)}><Icon name="arrow" /> {t.data.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section container reveal">
    <div class="two-col">
      <div>
        <h2 class="section-title">Experience</h2>
        <Timeline items={positions} />
      </div>
      <div>
        <h2 class="section-title">Education</h2>
        <Timeline items={education} />
      </div>
    </div>
  </section>

  <section class="section container reveal" aria-labelledby="keywords">
    <h2 class="section-title" id="keywords">Keywords across my papers</h2>
    <figure class="wordcloud">
      <img src={url('images/wordcloud.png')} alt="Word cloud of keywords from my publications, including leukemia, CMML, stem cells and scRNA-seq" loading="lazy" width="1194" height="404" />
    </figure>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  @media (min-width: 960px) {
    .hero { grid-template-columns: 1.05fr 1fr; }
  }

  .hero__person {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }

  .hero__person :global(.hero__photo) {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px var(--border);
  }

  .hero__name { margin: 0; font-weight: 700; }
  .hero__role { margin: 0; font-size: 0.88rem; color: var(--muted); }

  .hero__title {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  .hero__lead { max-width: 38em; margin: 0; font-size: 1.05rem; color: var(--text-soft); }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .highlights li {
    padding: 0.4rem 0.85rem;
    font-size: 0.85rem;
    color: var(--text-soft);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .highlights strong { color: var(--accent-text); }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__links a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .hero__links a:hover { color: var(--accent-text); border-color: var(--accent-text); transform: translateY(-2px); }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .research-card {
    padding: 1.4rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .research-card:hover { border-color: var(--link); transform: translateY(-2px); }

  .research-card__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.9rem;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 10px;
  }

  .research-card h3 { margin: 0 0 0.4rem; font-size: 1.02rem; }
  .research-card p { margin: 0; font-size: 0.93rem; line-height: 1.55; color: var(--text-soft); }

  .pub-list { display: flex; flex-direction: column; gap: 1rem; }

  .tutorials-band {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 3rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: linear-gradient(135deg, var(--accent-soft), var(--bg-soft));
    border: 1px solid var(--border);
    border-radius: 18px;
  }

  @media (min-width: 800px) { .tutorials-band { grid-template-columns: 1.2fr 1fr; align-items: center; } }

  .tutorials-band__title { margin: 0 0 0.5rem; font-size: 1.45rem; }
  .tutorials-band p { margin: 0 0 1.2rem; color: var(--text-soft); }

  .tutorials-band__list { margin: 0; padding: 0; list-style: none; }
  .tutorials-band__list li + li { border-top: 1px solid var(--border); }
  .tutorials-band__list a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 0;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }
  .tutorials-band__list a:hover { color: var(--accent-text); }
  .tutorials-band__list :global(svg) { color: var(--link); flex: none; }

  .two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 3rem;
  }

  @media (min-width: 800px) { .two-col { grid-template-columns: 1fr 1fr; } }

  .wordcloud { margin: 0; }
  .wordcloud img { width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
  :global([data-theme='dark']) .wordcloud img { filter: invert(1) hue-rotate(180deg) saturate(1.2); }
</style>
