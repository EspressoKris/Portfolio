---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PubCard from '../components/PubCard.astro';
import Timeline from '../components/Timeline.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ResearchAnim from '../components/ResearchAnim.astro';
import Icon from '../components/Icon.astro';
import { profile, intro, links, experience, education, awards, research } from '../data/profile';
import { url } from '../lib/url';
import profileImg from '../assets/profile.jpeg';

const pubs = (await getCollection('publications')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = pubs.filter((p) => p.data.featured);
const firstAuthor = pubs.filter((p) => p.data.role === 'First author').length;
const tutorials = (await getCollection('docs')).filter((d) => d.id.startsWith('tutorials/')).sort((a, b) => b.id.split('/').length - a.id.split('/').length);
---
<Base>
  <section class="hero container">
    <div class="hero__side">
      <div class="hero__photo-wrap">
        <Image
          src={profileImg}
          alt={`Portrait of ${profile.name}`}
          widths={[320, 480, 720]}
          sizes="(max-width: 760px) 220px, 360px"
          class="hero__photo"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero__id">
        <p class="eyebrow">Computational biology · Haemato-oncology</p>
        <h1 class="hero__name serif">{profile.title}</h1>
        <p class="hero__role">{profile.role} · {profile.employer}</p>
      </div>
    </div>

    <div class="hero__text">
      <p class="hero__statement">{intro.statement}</p>
      <div class="hero__lead">
        {intro.summary.map((para) => <p>{para}</p>)}
      </div>

      <ul class="highlights">
        <li><strong>{pubs.length}</strong> peer-reviewed papers</li>
        <li><strong>{firstAuthor}</strong> first-author</li>
        <li>{awards[0].title} {awards[0].dates}</li>
      </ul>

      <ul class="hero__links" aria-label="Profiles">
        {links.map((l) => (
          <li><a href={l.href} aria-label={l.label} title={l.label}><Icon name={l.icon} size="20" /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section container reveal" aria-labelledby="research">
    <div class="carousel" data-carousel>
      <div class="section-title carousel__head">
        <h2 id="research">Research topics</h2>
        <div class="carousel__arrows">
          <button type="button" class="carousel__btn" data-prev aria-label="Previous research topics">←</button>
          <button type="button" class="carousel__btn" data-next aria-label="Next research topics">→</button>
        </div>
      </div>
      <div class="carousel__track research-grid" data-track tabindex="0" role="region" aria-roledescription="carousel" aria-labelledby="research">
        {research.map((r, i) => (
          <div class="research-card" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${research.length}: ${r.title}`}>
            <ResearchAnim kind={r.anim} />
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
      <div class="carousel__dots" data-dots aria-label="Choose research topics"></div>
    </div>
  </section>

  <section class="section container reveal">
    <div class="two-col">
      <div>
        <h2 class="section-title">Education</h2>
        <Timeline items={education} />
      </div>
      <div>
        <h2 class="section-title">Keywords across my papers</h2>
        <figure class="wordcloud">
          <img src={url('images/wordcloud.png')} alt="Word cloud of keywords from my publications, including leukemia, CMML, stem cells and scRNA-seq" loading="lazy" width="1194" height="404" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section container reveal" aria-labelledby="experience">
    <h2 class="section-title" id="experience">Experience</h2>
    <ExperienceList items={experience} />
  </section>

  <section class="section container reveal" aria-labelledby="selected">
    <h2 class="section-title" id="selected">
      Recent selected publications
      <a href={url('publications/')}>All {pubs.length} papers →</a>
    </h2>
    <div class="pub-list">
      {featured.map((p) => <PubCard pub={p} />)}
    </div>
  </section>

  <section class="section container reveal" aria-labelledby="tutorials">
    <div class="tutorials-band">
      <div>
        <p class="eyebrow">Tutorials</p>
        <h2 id="tutorials" class="tutorials-band__title">Hands-on bioinformatics, start to finish</h2>
        <p>Step-by-step guides for bulk and single-cell RNA-seq, written for people who want to run the analysis themselves.</p>
        <a class="btn" href={url('tutorials/')}><Icon name="book" /> Browse tutorials</a>
      </div>
      <ul class="tutorials-band__list">
        {tutorials.slice(0, 4).map((t) => (
          <li><a href={url(`${t.id}/`)}><Icon name="arrow" /> {t.data.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

</Base>


<script>
  // Research carousel: arrows, dots, swipe/scroll, and gentle auto-advance.
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const dotsEl = root.querySelector<HTMLElement>('[data-dots]')!;
    const cards = [...track.children] as HTMLElement[];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTO_MS = 12000; // about one round of the animations

    const perView = () => Math.max(1, Math.round(track.clientWidth / cards[0].getBoundingClientRect().width));
    const pages = () => Math.ceil(cards.length / perView());
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const goTo = (page: number) => {
      const n = pages();
      const p = ((page % n) + n) % n;
      const card = cards[Math.min(p * perView(), cards.length - 1)];
      track.scrollTo({ left: card.offsetLeft - track.offsetLeft - 2, behavior: reduced ? 'auto' : 'smooth' });
    };

    const renderDots = () => {
      const n = pages();
      dotsEl.innerHTML = '';
      for (let i = 0; i < n; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', `Show topics ${i * perView() + 1}–${Math.min((i + 1) * perView(), cards.length)}`);
        b.addEventListener('click', () => { goTo(i); restart(); });
        dotsEl.appendChild(b);
      }
      dotsEl.hidden = n < 2;
      root.querySelector<HTMLElement>('.carousel__arrows')!.hidden = n < 2;
      markDot();
    };
    const markDot = () => {
      const c = current();
      [...dotsEl.children].forEach((d, i) => d.setAttribute('aria-current', String(i === c)));
    };

    root.querySelector('[data-prev]')!.addEventListener('click', () => { goTo(current() - 1); restart(); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { goTo(current() + 1); restart(); });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current() + 1); restart(); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current() - 1); restart(); }
    });
    let scrollTimer = 0;
    track.addEventListener('scroll', () => { clearTimeout(scrollTimer); scrollTimer = window.setTimeout(markDot, 80); }, { passive: true });

    // auto-advance only while visible and not being used
    let timer = 0, paused = false, visible = false;
    const tick = () => { if (!paused && visible && !document.hidden) goTo(current() + 1); };
    function restart() { clearInterval(timer); if (!reduced) timer = window.setInterval(tick, AUTO_MS); }
    root.addEventListener('pointerenter', () => (paused = true));
    root.addEventListener('pointerleave', () => (paused = false));
    root.addEventListener('focusin', () => (paused = true));
    root.addEventListener('focusout', () => (paused = false));
    track.addEventListener('touchstart', () => restart(), { passive: true });
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(track);

    new ResizeObserver(renderDots).observe(track);
    renderDots();
    restart();
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 4rem);
    align-items: start;
    padding-top: clamp(2rem, 6vw, 4.5rem);
  }

  @media (min-width: 760px) {
    .hero { grid-template-columns: minmax(240px, 360px) 1fr; }
  }

  .hero__photo-wrap {
    position: relative;
    width: min(220px, 60vw);
    isolation: isolate;
  }

  @media (min-width: 760px) { .hero__photo-wrap { width: 100%; } }

  /* soft offset block behind the photo */
  .hero__photo-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(135deg, var(--accent), var(--link));
    border-radius: 28px;
    opacity: 0.18;
    transform: translate(14px, 14px) rotate(2deg);
  }

  .hero__photo-wrap :global(.hero__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 24px;
    box-shadow: var(--shadow);
  }

  .hero__id { margin-top: 1.8rem; }
  .hero__id .eyebrow { margin-bottom: 0.5rem; letter-spacing: 0.08em; }

  .hero__name {
    margin: 0;
    font-size: clamp(1.45rem, 2.1vw, 1.65rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .hero__role { margin: 0.4rem 0 0; font-size: 0.93rem; color: var(--muted); }

  .hero__statement {
    max-width: 30em;
    margin: 1.3rem 0 0.9rem;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }

  .hero__lead { max-width: 42em; font-size: 1rem; line-height: 1.7; color: var(--text-soft); }
  .hero__lead p { margin: 0 0 0.85rem; }
  .hero__lead p:last-child { margin-bottom: 0; }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .highlights li {
    padding: 0.4rem 0.85rem;
    font-size: 0.85rem;
    color: var(--text-soft);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .highlights strong { color: var(--accent-text); }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__links a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .hero__links a:hover { color: var(--accent-text); border-color: var(--accent-text); transform: translateY(-2px); }

  /* Research carousel: 3 cards per view on desktop, 2 on tablet, 1 on phone */
  .carousel__head { align-items: center; }
  .carousel__head h2 { margin: 0; font-size: inherit; }
  .carousel__arrows { display: flex; gap: 0.4rem; }

  .carousel__btn {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    padding: 0;
    font: inherit;
    font-size: 1rem;
    color: var(--text-soft);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .carousel__btn:hover { color: var(--accent-text); border-color: var(--accent-text); background: var(--accent-soft); }

  .research-grid {
    --per-view: 1;
    --gap: 1rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 4px 2px 6px;
    margin: -4px -2px -6px;
  }

  .research-grid::-webkit-scrollbar { display: none; }
  .research-grid > * { scroll-snap-align: start; }

  @media (min-width: 620px) { .research-grid { --per-view: 2; } }
  @media (min-width: 960px) { .research-grid { --per-view: 3; } }

  .carousel__dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem; }

  .carousel__dots :global(button) {
    width: 0.6rem;
    height: 0.6rem;
    padding: 0;
    background: var(--border);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: width 0.25s ease, background-color 0.25s ease;
  }

  .carousel__dots :global(button[aria-current='true']) { width: 1.6rem; background: var(--accent); }

  .research-card {
    padding: 1.4rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .research-card:hover { border-color: var(--link); transform: translateY(-2px); }

  .research-card h3 { margin: 0 0 0.4rem; font-size: 1.02rem; }
  .research-card p { margin: 0; font-size: 0.93rem; line-height: 1.55; color: var(--text-soft); }

  .pub-list { display: flex; flex-direction: column; gap: 1rem; }

  .tutorials-band {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 3rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: linear-gradient(135deg, var(--accent-soft), var(--bg-soft));
    border: 1px solid var(--border);
    border-radius: 18px;
  }

  @media (min-width: 800px) { .tutorials-band { grid-template-columns: 1.2fr 1fr; align-items: center; } }

  .tutorials-band__title { margin: 0 0 0.5rem; font-size: 1.45rem; }
  .tutorials-band p { margin: 0 0 1.2rem; color: var(--text-soft); }

  .tutorials-band__list { margin: 0; padding: 0; list-style: none; }
  .tutorials-band__list li + li { border-top: 1px solid var(--border); }
  .tutorials-band__list a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 0;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }
  .tutorials-band__list a:hover { color: var(--accent-text); }
  .tutorials-band__list :global(svg) { color: var(--link); flex: none; }

  .two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 3rem;
  }

  @media (min-width: 800px) { .two-col { grid-template-columns: 1fr 1fr; } }

  .wordcloud { margin: 0; }
  .wordcloud img { width: 100%; max-width: 720px; height: auto; margin: 0 auto; }
  :global([data-theme='dark']) .wordcloud img { filter: invert(1) hue-rotate(180deg) saturate(1.2); }
</style>
