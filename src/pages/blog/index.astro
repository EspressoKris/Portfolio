---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog" description="Writing by Kristian Gurashi on genomics, biotech and computational biology.">
  <div class="container narrow page">
    <p class="eyebrow">Blog</p>
    <h1 class="serif page__title">Writing</h1>
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a class="post" href={url(`blog/${p.id}/`)}>
            <time datetime={p.data.date.toISOString().slice(0, 10)}>
              {p.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
            </time>
            <span class="post__title">{p.data.title}</span>
            {p.data.excerpt && <span class="post__excerpt">{p.data.excerpt}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page { padding-top: clamp(2rem, 6vw, 3.5rem); }
  .page__title { margin: 0 0 1.8rem; font-size: clamp(2rem, 4vw, 2.6rem); }
  .posts { margin: 0; padding: 0; list-style: none; }
  .post {
    display: grid;
    gap: 0.25rem;
    padding: 1.2rem;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .post:hover { border-color: var(--link); transform: translateY(-2px); }
  time { font-size: 0.8rem; color: var(--muted); }
  .post__title { font-size: 1.15rem; font-weight: 600; color: var(--text); }
  .post__excerpt { color: var(--text-soft); font-size: 0.93rem; }
</style>
