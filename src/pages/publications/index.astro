---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubCard from '../../components/PubCard.astro';
import Icon from '../../components/Icon.astro';
import { links } from '../../data/profile';

const pubs = (await getCollection('publications')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const years = [...new Set(pubs.map((p) => p.data.date.getFullYear()))];

// Topic chips: the most common keywords (case-insensitive), excluding very generic ones.
const generic = new Set(['leukemia']);
const counts = new Map<string, { label: string; n: number }>();
for (const p of pubs) for (const k of p.data.keywords) {
  const key = k.toLowerCase();
  if (generic.has(key)) continue;
  const c = counts.get(key) ?? { label: k, n: 0 };
  c.n++; counts.set(key, c);
}
const topics = [...counts.entries()].sort((a, b) => b[1].n - a[1].n || a[0].localeCompare(b[0])).slice(0, 10);
const scholar = links.find((l) => l.label === 'Google Scholar')!.href;
const orcid = links.find((l) => l.label === 'ORCID')!.href;
---
<Base title="Publications" description="Peer-reviewed publications by Kristian Gurashi on CMML, MDS, myelofibrosis and leukaemic stem cells.">
  <div class="container narrow page">
    <p class="eyebrow">Publications</p>
    <h1 class="serif page__title">Research papers</h1>
    <p class="page__intro">
      {pubs.length} peer-reviewed papers. Also on <a href={scholar}>Google Scholar</a> and <a href={orcid}>ORCID</a>.
    </p>

    <div class="filters" data-filters hidden>
      <label class="search">
        <Icon name="search" />
        <span class="sr-only">Search publications</span>
        <input type="search" placeholder="Search title, author, journal, topic…" data-search autocomplete="off" />
      </label>

      <div class="filter-row" role="group" aria-label="Year">
        <button type="button" class="chip" data-year="all" aria-pressed="true">All years</button>
        {years.map((y) => <button type="button" class="chip" data-year={y} aria-pressed="false">{y}</button>)}
        <button type="button" class="chip" data-first aria-pressed="false">First author</button>
      </div>

      <div class="filter-row" role="group" aria-label="Topic">
        {topics.map(([key, t]) => (
          <button type="button" class="chip chip--topic" data-topic={key} aria-pressed="false">{t.label} <span class="chip__n">{t.n}</span></button>
        ))}
      </div>

      <p class="results" aria-live="polite" data-results></p>
    </div>

    <div class="pub-list" data-list>
      {pubs.map((p) => <PubCard pub={p} />)}
    </div>
    <p class="empty" data-empty hidden>No papers match. <button type="button" class="linklike" data-reset>Clear filters</button></p>
  </div>
</Base>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  if (filters) {
    filters.hidden = false; // filters only make sense with JavaScript
    const cards = [...document.querySelectorAll<HTMLElement>('[data-list] .pub-card')];
    const input = filters.querySelector<HTMLInputElement>('[data-search]')!;
    const yearBtns = [...filters.querySelectorAll<HTMLButtonElement>('[data-year]')];
    const firstBtn = filters.querySelector<HTMLButtonElement>('[data-first]')!;
    const topicBtns = [...filters.querySelectorAll<HTMLButtonElement>('[data-topic]')];
    const results = filters.querySelector<HTMLElement>('[data-results]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;

    const state = { q: '', year: 'all', first: false, topics: new Set<string>() };

    function apply() {
      const terms = state.q.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const c of cards) {
        const kw = (c.dataset.keywords ?? '').split('|');
        const ok =
          (state.year === 'all' || c.dataset.year === state.year) &&
          (!state.first || c.dataset.first === 'true') &&
          [...state.topics].every((t) => kw.includes(t)) &&
          terms.every((t) => (c.dataset.search ?? '').includes(t));
        c.hidden = !ok;
        if (ok) shown++;
      }
      results.textContent = shown === cards.length ? `Showing all ${cards.length} papers` : `Showing ${shown} of ${cards.length} papers`;
      empty.hidden = shown > 0;
      yearBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.year === state.year)));
      firstBtn.setAttribute('aria-pressed', String(state.first));
      topicBtns.forEach((b) => b.setAttribute('aria-pressed', String(state.topics.has(b.dataset.topic!))));
    }

    input.addEventListener('input', () => { state.q = input.value; apply(); });
    yearBtns.forEach((b) => b.addEventListener('click', () => { state.year = b.dataset.year!; apply(); }));
    firstBtn.addEventListener('click', () => { state.first = !state.first; apply(); });
    topicBtns.forEach((b) => b.addEventListener('click', () => {
      const t = b.dataset.topic!;
      state.topics.has(t) ? state.topics.delete(t) : state.topics.add(t);
      apply();
    }));
    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      Object.assign(state, { q: '', year: 'all', first: false }); state.topics.clear(); input.value = ''; apply();
    });

    // Allow links like /publications/?topic=cmml
    const params = new URLSearchParams(location.search);
    const t = params.get('topic');
    if (t) state.topics.add(t.toLowerCase());
    apply();
  }
</script>

<style>
  .page { padding-top: clamp(2rem, 6vw, 3.5rem); }
  .page__title { margin: 0 0 0.5rem; font-size: clamp(2rem, 4vw, 2.6rem); }
  .page__intro { margin: 0 0 1.8rem; color: var(--text-soft); }

  .filters {
    display: grid;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.9rem;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .search:focus-within { border-color: var(--link); }

  .search input {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 0;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: transparent;
    border: 0;
    outline: none;
  }

  .filter-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .chip__n { font-size: 0.72rem; opacity: 0.65; }

  .results { margin: 0; font-size: 0.8rem; color: var(--muted); }

  .pub-list { display: flex; flex-direction: column; gap: 1rem; }

  .empty { color: var(--muted); }

  .linklike {
    padding: 0;
    font: inherit;
    color: var(--link);
    text-decoration: underline;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
