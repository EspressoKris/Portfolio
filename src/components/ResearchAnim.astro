---
// Small looping illustration for a research card. Purely decorative.
//   clusters  — cells settle into cell-type clusters, then shift from healthy to disease;
//               proportion bars below compare the two states
//   evolution — a clone spreads, two subclones (green, red) compete inside it;
//               a fish plot below builds up over time from the same cells
//   tree      — patients flow down a decision tree into subgroups;
//               bar charts below show each group's response to three compounds
//   risk      — a risk variant opens up DNA (chromatin peaks) and raises gene activity
//   niche     — zoom from a tissue section into its cells; dendritic cells signal to stem
//               cells, then an inhibitor blocks the signal
//   response  — patients coloured by a signature score sort into transfusion-free vs
//               still transfused after treatment
//   clones    — bulk gives one blended number; single cells reveal one- vs two-hit clones
//   antibody  — B cells whose antibodies bind a virus expand; candidates are collected
//   pipeline  — samples flow through a workflow; steps light up; same result every run
interface Props { kind: 'clusters' | 'evolution' | 'tree' | 'risk' | 'niche' | 'response' | 'clones' | 'antibody' | 'pipeline' }
const { kind } = Astro.props;
---
<div class="ranim">
  <canvas data-anim={kind} aria-hidden="true"></canvas>
</div>

<script>
  type Ctx = CanvasRenderingContext2D;
  type Scene = { draw: (ctx: Ctx, w: number, h: number, t: number) => void; still: number };

  const C = { orange: '#f28e2b', blue: '#4e79a7', green: '#59a14f', red: '#e15759', purple: '#b07aa1', teal: '#76b7b2', yellow: '#e9b949' };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const css = (name: string, fallback: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;
  let theme = { muted: '#66727e', border: '#e2e7ed', text: '#17212b', soft: '#3b4752', surface: '#ffffff', font: 'sans-serif' };
  const readTheme = () =>
    (theme = {
      muted: css('--muted', theme.muted),
      border: css('--border', theme.border),
      text: css('--text', theme.text),
      soft: css('--text-soft', theme.soft),
      surface: css('--surface', theme.surface),
      font: getComputedStyle(document.body).fontFamily || 'sans-serif',
    });
  readTheme();

  function rng(seed: number) {
    return () => {
      seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  const ease = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const clamp01 = (x: number) => Math.max(0, Math.min(1, x));

  function dot(ctx: Ctx, x: number, y: number, r: number, color: string, alpha = 1) {
    if (alpha <= 0) return;
    ctx.globalAlpha = alpha;
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  function label(ctx: Ctx, text: string, x: number, y: number, opts: { size?: number; color?: string; align?: CanvasTextAlign; weight?: number } = {}) {
    ctx.font = `${opts.weight ?? 500} ${opts.size ?? 10}px ${theme.font}`;
    ctx.fillStyle = opts.color ?? theme.muted;
    ctx.textAlign = opts.align ?? 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, x, y);
  }

  function roundRect(ctx: Ctx, x: number, y: number, w: number, h: number, r: number) {
    const rr = Math.min(r, w / 2, h / 2);
    ctx.beginPath();
    ctx.moveTo(x + rr, y);
    ctx.arcTo(x + w, y, x + w, y + h, rr);
    ctx.arcTo(x + w, y + h, x, y + h, rr);
    ctx.arcTo(x, y + h, x, y, rr);
    ctx.arcTo(x, y, x + w, y, rr);
    ctx.closePath();
  }

  // 1. Cells settle into clusters (healthy), then one population expands (disease).
  function clusters(): Scene {
    const r = rng(7), g = () => { let u = 0, v = 0; while (!u) u = r(); while (!v) v = r(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };
    const colors = [C.blue, C.orange, C.green, C.purple];
    const names = ['Monocytes', 'Neutrophils', 'Erythroid', 'Lymphoid'];
    const centres = [[0.24, 0.3], [0.66, 0.24], [0.34, 0.74], [0.78, 0.7]];
    const healthy = [30, 30, 30, 30];
    const disease = [62, 20, 22, 16];
    const sample = (c: number) => [centres[c][0] + g() * (c === 0 ? 0.075 : 0.06), centres[c][1] + g() * 0.085];
    // pair cells: keep type where possible, move the surplus into the expanding population
    const pts: { sx: number; sy: number; hc: number; dc: number; hx: number; hy: number; dx: number; dy: number; d: number }[] = [];
    const movers: number[] = [];
    healthy.forEach((n, c) => {
      for (let i = 0; i < n; i++) {
        const [hx, hy] = sample(c);
        const stays = i < Math.min(n, disease[c]);
        const p = { sx: 0.05 + r() * 0.9, sy: 0.06 + r() * 0.88, hc: c, dc: c, hx, hy, dx: hx + g() * 0.01, dy: hy + g() * 0.01, d: r() * 0.6 };
        if (!stays) movers.push(pts.length);
        pts.push(p);
      }
    });
    movers.forEach((idx) => { const [dx, dy] = sample(0); Object.assign(pts[idx], { dc: 0, dx, dy }); });

    const P = 11;
    return {
      still: 7.2,
      draw(ctx, w, h, t) {
        const s = t % P;
        const plotH = h * 0.64;
        const form = (p: { d: number }) => ease(clamp01((s - 0.7 - p.d) / 1.6));
        const shift = (p: { d: number }) => ease(clamp01((s - 4.6 - p.d * 0.5) / 1.6));
        const out = (p: { d: number }) => ease(clamp01((s - 9.3 - p.d * 0.4) / 1.3));
        for (const p of pts) {
          const k = form(p) * (1 - out(p)), m = shift(p);
          const tx = p.hx + (p.dx - p.hx) * m, ty = p.hy + (p.dy - p.hy) * m;
          const breathe = Math.sin(t * 1.3 + p.d * 9) * 0.005 * k;
          const x = (p.sx + (tx - p.sx) * k + breathe) * w;
          const y = (p.sy + (ty - p.sy) * k + breathe) * plotH;
          const col = m > 0.5 ? colors[p.dc] : colors[p.hc];
          dot(ctx, x, y, 2.4, theme.muted, 0.4 * (1 - k));
          dot(ctx, x, y, 2.4, col, 0.9 * k);
        }

        // proportion bars
        const fadeOut = 1 - ease(clamp01((s - 9.3) / 1.3));
        const fillH = ease(clamp01((s - 1.2) / 1.6)) * fadeOut;
        const fillD = ease(clamp01((s - 5.0) / 1.6)) * fadeOut;
        const x0 = w * 0.25, bw = w * 0.71, bh = Math.max(9, h * 0.07);
        const rows: [string, number[], number, boolean][] = [
          ['Healthy', healthy, fillH, s < 4.9],
          ['Disease', disease, fillD, s >= 4.9 && s < 9.3],
        ];
        rows.forEach(([name, counts, fill, active], i) => {
          const y = h * (0.75 + i * 0.13);
          label(ctx, name, w * 0.04, y + bh / 2, { size: 10.5, color: active ? theme.text : theme.muted, weight: active ? 650 : 500 });
          ctx.fillStyle = theme.border;
          roundRect(ctx, x0, y, bw, bh, 3); ctx.fill();
          const total = counts.reduce((a, b) => a + b, 0);
          ctx.save();
          roundRect(ctx, x0, y, bw * fill, bh, 3); ctx.clip();
          let x = x0;
          counts.forEach((n, c) => { const segW = (n / total) * bw; ctx.fillStyle = colors[c]; ctx.fillRect(x, y, segW + 0.5, bh); x += segW; });
          ctx.restore();
        });
        // tiny legend for the expanding population
        if (fillD > 0.6) label(ctx, `${names[0]} ↑`, w * 0.96, h * 0.7, { size: 9.5, color: colors[0], align: 'right', weight: 650 });
      },
    };
  }

  // 2. A clone (yellow) spreads; green and red subclones compete inside it. Fish plot below.
  function evolution(): Scene {
    const r = rng(11);
    const cols = 19, rows = 7;
    const P = 11.5, fade = 1.2, tEnd = P - fade;
    const seedA = [0.24, 0.5], seedG = [0.36, 0.25], seedR = [0.4, 0.78];
    type Cell = { x: number; y: number; tA: number; tG: number; tR: number };
    const cells: Cell[] = [];
    for (let j = 0; j < rows; j++) for (let i = 0; i < cols; i++) {
      const x = 0.04 + (i + (j % 2) * 0.5) / (cols - 0.5) * 0.92 + (r() - 0.5) * 0.01;
      const y = j / (rows - 1) + (r() - 0.5) * 0.02;
      const d = (s: number[]) => Math.hypot((x - s[0]) * 2, (y - s[1]) * 0.55);
      const tA = 0.5 + d(seedA) * 2.4 + r() * 0.4;
      cells.push({
        x, y, tA,
        tG: Math.max(2.6 + d(seedG) * 1.7 + r() * 0.35, tA + 0.4), // green spreads fast...
        tR: Math.max(4.0 + d(seedR) * 7.5 + r() * 0.35, tA + 0.4), // ...red starts later and gains ground; green holds ~20%
      });
    }
    const state = (c: Cell, s: number) => (s >= c.tR ? 3 : s >= c.tG ? 2 : s >= c.tA ? 1 : 0);
    // fish plot samples from the same cells
    const N = 90;
    const fish = Array.from({ length: N }, (_, i) => {
      const s = (i / (N - 1)) * tEnd;
      let a = 0, gr = 0, rd = 0;
      for (const c of cells) { const st = state(c, s); if (st >= 1) a++; if (st === 2) gr++; if (st === 3) rd++; }
      return { a: a / cells.length, g: gr / cells.length, r: rd / cells.length };
    });
    const colorOf = [null, C.yellow, C.green, C.red] as const;

    return {
      still: tEnd - 0.05,
      draw(ctx, w, h, t) {
        const s = t % P;
        const out = clamp01((s - tEnd) / fade);
        const gy0 = h * 0.06, gy1 = h * 0.52;
        const rad = Math.max(2.2, Math.min(3.4, w / 115));
        for (const c of cells) {
          const st = state(c, s);
          const x = c.x * w, y = gy0 + c.y * (gy1 - gy0);
          if (st === 0) { dot(ctx, x, y, rad, theme.muted, 0.35); continue; }
          const since = s - (st === 3 ? c.tR : st === 2 ? c.tG : c.tA);
          const pulse = out > 0 ? 1 : 1 + 0.8 * Math.exp(-since * 5);
          dot(ctx, x, y, rad, theme.muted, 0.35 * out);
          dot(ctx, x, y, rad * pulse, colorOf[st]!, 0.92 * (1 - out));
        }

        // fish plot: grows left to right with time
        const fx0 = w * 0.04, fx1 = w * 0.96, fy0 = h * 0.62, fy1 = h * 0.95, cy = (fy0 + fy1) / 2, fh = fy1 - fy0;
        ctx.fillStyle = theme.border;
        ctx.globalAlpha = 0.55;
        roundRect(ctx, fx0, fy0, fx1 - fx0, fh, 6); ctx.fill();
        ctx.globalAlpha = 1;
        const upto = Math.min(N - 1, Math.floor((Math.min(s, tEnd) / tEnd) * (N - 1)));
        const X = (i: number) => fx0 + (i / (N - 1)) * (fx1 - fx0);
        const band = (top: (f: (typeof fish)[number]) => number, bottom: (f: (typeof fish)[number]) => number, color: string) => {
          if (upto < 1) return;
          ctx.beginPath();
          for (let i = 0; i <= upto; i++) ctx.lineTo(X(i), top(fish[i]));
          for (let i = upto; i >= 0; i--) ctx.lineTo(X(i), bottom(fish[i]));
          ctx.closePath();
          ctx.globalAlpha = 0.9 * (1 - out);
          ctx.fillStyle = color;
          ctx.fill();
          ctx.globalAlpha = 1;
        };
        const H = fh * 0.88;
        const topA = (f: (typeof fish)[number]) => cy - (f.a * H) / 2;
        const yG0 = (f: (typeof fish)[number]) => topA(f) + ((f.a - f.g - f.r) * H) / 2;
        const yG1 = (f: (typeof fish)[number]) => yG0(f) + f.g * H;
        const yR1 = (f: (typeof fish)[number]) => yG1(f) + f.r * H;
        band(topA, (f) => cy + (f.a * H) / 2, C.yellow);
        band(yG0, yG1, C.green);
        band(yG1, yR1, C.red);
        // time cursor
        if (out === 0 && upto > 0) {
          ctx.strokeStyle = theme.text; ctx.globalAlpha = 0.35; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(X(upto), fy0 + 3); ctx.lineTo(X(upto), fy1 - 3); ctx.stroke();
          ctx.globalAlpha = 1;
        }
        label(ctx, 'time →', fx0 + 6, fy1 - 7, { size: 9 });
      },
    };
  }

  // Point on a cubic Bézier curve.
  const bez = (p0: number[], p1: number[], p2: number[], p3: number[], t: number): [number, number] => {
    const u = 1 - t;
    return [
      u * u * u * p0[0] + 3 * u * u * t * p1[0] + 3 * u * t * t * p2[0] + t * t * t * p3[0],
      u * u * u * p0[1] + 3 * u * u * t * p1[1] + 3 * u * t * t * p2[1] + t * t * t * p3[1],
    ];
  };
  // Smooth vertical "elbow" from a to b (tree branches).
  const elbow = (a: number[], b: number[]) => {
    const ym = (a[1] + b[1]) / 2;
    return [a, [a[0], ym], [b[0], ym], b] as const;
  };

  function pill(ctx: Ctx, cx: number, cy: number, text: string, bg: string, fg: string, size = 9.5, alpha = 1) {
    ctx.font = `650 ${size}px ${theme.font}`;
    const tw = ctx.measureText(text).width, ph = size + 8, pw = tw + 14;
    ctx.globalAlpha = alpha;
    ctx.fillStyle = bg;
    roundRect(ctx, cx - pw / 2, cy - ph / 2, pw, ph, ph / 2);
    ctx.fill();
    ctx.globalAlpha = 1;
    label(ctx, text, cx, cy + 0.5, { size, color: fg, align: 'center', weight: 650 });
  }

  // 3. Patients flow down a decision tree into groups; each group responds differently to compounds.
  function tree(): Scene {
    const r = rng(23);
    const root = [0.5, 0.09];
    const mid = [[0.28, 0.25], [0.72, 0.25]];
    const leaves = [[0.13, 0.42], [0.38, 0.42], [0.62, 0.42], [0.87, 0.42]];
    const colors = [C.blue, C.orange, C.green, C.purple];
    const response = [[0.92, 0.22, 0.38], [0.18, 0.88, 0.45], [0.48, 0.28, 0.94], [0.3, 0.62, 0.18]];
    type Mover = { leaf: number; born: number };
    let movers: Mover[] = [];
    const counts = [9, 7, 8, 6];
    const flash = [-10, -10, -10, -10];
    let nextSpawn = 0;
    const travel = 1.7;
    const path = (leaf: number, k: number): [number, number] => {
      const a = mid[leaf < 2 ? 0 : 1];
      if (k < 0.5) { const [p0, p1, p2, p3] = elbow(root, a); return bez(p0, p1, p2, p3, ease(k * 2)); }
      const [p0, p1, p2, p3] = elbow(a, leaves[leaf]); return bez(p0, p1, p2, p3, ease((k - 0.5) * 2));
    };
    return {
      still: 0,
      draw(ctx, w, h, t) {
        const P = (p: number[]) => [p[0] * w, p[1] * h];
        // branches
        ctx.strokeStyle = theme.border;
        ctx.lineWidth = 2;
        ctx.lineCap = 'round';
        const curve = (a: number[], b: number[]) => {
          const [p0, p1, p2, p3] = elbow(a, b).map(P);
          ctx.beginPath(); ctx.moveTo(p0[0], p0[1]); ctx.bezierCurveTo(p1[0], p1[1], p2[0], p2[1], p3[0], p3[1]); ctx.stroke();
        };
        mid.forEach((a, i) => { curve(root, a); curve(a, leaves[i * 2]); curve(a, leaves[i * 2 + 1]); });
        mid.forEach((a) => { dot(ctx, a[0] * w, a[1] * h, 4.5, theme.border, 1); dot(ctx, a[0] * w, a[1] * h, 2.2, theme.muted, 1); });

        // travelling patients
        if (!reduced) {
          if (t >= nextSpawn) {
            const u = r();
            movers.push({ leaf: u < 0.28 ? 0 : u < 0.52 ? 1 : u < 0.78 ? 2 : 3, born: t });
            nextSpawn = t + 0.38 + r() * 0.22;
          }
          movers = movers.filter((m) => {
            const k = (t - m.born) / travel;
            if (k >= 1) { counts[m.leaf]++; flash[m.leaf] = t; return false; }
            const [x, y] = path(m.leaf, k);
            const c = k < 0.5 ? theme.muted : colors[m.leaf];
            dot(ctx, x * w, y * h, 5, c, 0.15);
            dot(ctx, x * w, y * h, 2.6, c, 0.95);
            return true;
          });
        }
        pill(ctx, root[0] * w, root[1] * h, 'Patients', theme.text, theme.surface, 9.5);

        // group pills with patient counts
        leaves.forEach((l, i) => {
          const f = Math.exp(-(t - flash[i]) * 6);
          const [x, y] = P(l);
          if (f > 0.02) dot(ctx, x, y, 16 + f * 6, colors[i], 0.12 * f);
          pill(ctx, x, y, `Group ${i + 1}`, colors[i], '#ffffff', 9);
          label(ctx, `n = ${counts[i]}`, x, y + 15, { size: 8.5, align: 'center' });
        });

        // drug-response panel
        const top = h * 0.6, base = h * 0.9, maxH = base - top - h * 0.04;
        ctx.strokeStyle = theme.border; ctx.lineWidth = 1;
        ctx.setLineDash([3, 3]);
        ctx.beginPath(); ctx.moveTo(w * 0.04, top - h * 0.02); ctx.lineTo(w * 0.96, top - h * 0.02); ctx.stroke();
        ctx.setLineDash([]);
        label(ctx, 'Drug response', w * 0.04, top + h * 0.02, { size: 8.5, weight: 650 });
        const bw = Math.max(6, w * 0.036), gap = Math.max(2, w * 0.01);
        const grow = reduced ? 1 : ease(clamp01(t / 1.8));
        leaves.forEach((l, gi) => {
          const x0 = l[0] * w - (3 * bw + 2 * gap) / 2;
          response[gi].forEach((v, ci) => {
            const x = x0 + ci * (bw + gap);
            ctx.fillStyle = theme.border; ctx.globalAlpha = 0.5;
            roundRect(ctx, x, base - maxH, bw, maxH, 3); ctx.fill();
            const wob = reduced ? 1 : 0.92 + 0.08 * Math.sin(t * 1.5 + gi * 1.7 + ci * 2.3);
            const bh = Math.max(2, v * maxH * grow * wob);
            ctx.globalAlpha = 0.35 + 0.65 * v;
            ctx.fillStyle = colors[gi];
            roundRect(ctx, x, base - bh, bw, bh, 3); ctx.fill();
            ctx.globalAlpha = 1;
            label(ctx, 'ABC'[ci], x + bw / 2, base + 8, { size: 8.5, align: 'center', color: v > 0.8 ? theme.text : theme.muted, weight: v > 0.8 ? 700 : 500 });
          });
        });
      },
    };
  }

  // 4. Genetic risk: a variant changes how open the DNA is (chromatin) and how active a gene is.
  function risk(): Scene {
    const peaks = [0.16, 0.28, 0.42, 0.62, 0.8];
    const ref = [0.45, 0.3, 0.32, 0.7, 0.42];
    const alt = [0.45, 0.3, 0.95, 0.74, 0.42];
    const variantX = 0.42;
    const P = 9.5;
    const profile = (x: number, hs: number[]) => hs.reduce((s, hh, i) => s + hh * Math.exp(-(((x - peaks[i]) / 0.022) ** 2)), 0);
    return {
      still: 6.6,
      draw(ctx, w, h, t) {
        const s = t % P;
        const out = ease(clamp01((s - 8.3) / 1.0));
        const vis = 1 - out;
        const x0 = 0.05, x1 = 0.95;
        // gene track
        const gy = h * 0.14;
        label(ctx, 'DNA', w * x0, h * 0.055, { size: 8.5, weight: 650 });
        ctx.strokeStyle = theme.muted; ctx.globalAlpha = 0.6; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(w * x0, gy); ctx.lineTo(w * x1, gy); ctx.stroke();
        ctx.globalAlpha = 1;
        [[0.55, 0.6], [0.66, 0.7], [0.76, 0.86]].forEach(([a, b]) => { ctx.fillStyle = theme.muted; roundRect(ctx, w * a, gy - 5, w * (b - a), 10, 2); ctx.fill(); });
        label(ctx, 'gene', w * 0.71, gy - 12, { size: 8.5, align: 'center' });

        // scan sweep
        const scan = clamp01((s - 1.4) / 2.8);
        const reached = scan * (x1 - x0) + x0 >= variantX;
        const pulse = reached ? Math.exp(-(s - (1.4 + ((variantX - x0) / (x1 - x0)) * 2.8)) * 2.5) : 0;
        // variant lollipop
        ctx.strokeStyle = reached ? C.red : theme.muted; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(w * variantX, gy); ctx.lineTo(w * variantX, h * 0.05); ctx.stroke();
        dot(ctx, w * variantX, h * 0.05, 3.5 + pulse * 3, reached ? C.red : theme.muted, 1);
        label(ctx, 'risk variant', w * variantX + 8, h * 0.05, { size: 8.5, color: reached ? C.red : theme.muted, weight: 650 });

        // chromatin tracks
        const rise = ease(clamp01((s - 0.2) / 1.2)) * vis;
        const tracks: [string, number[], string, number][] = [['Reference', ref, C.blue, 0.44], ['Risk allele', alt, C.red, 0.66]];
        const th = h * 0.17;
        for (const [name, hs, col, baseY] of tracks) {
          const by = h * baseY;
          ctx.strokeStyle = theme.border; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(w * x0, by); ctx.lineTo(w * x1, by); ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(w * x0, by);
          for (let i = 0; i <= 120; i++) {
            const x = x0 + (i / 120) * (x1 - x0);
            const boost = name === 'Risk allele' && Math.abs(x - variantX) < 0.05 ? 1 + 0.15 * pulse : 1;
            ctx.lineTo(w * x, by - profile(x, hs) * th * rise * boost);
          }
          ctx.lineTo(w * x1, by);
          ctx.closePath();
          ctx.globalAlpha = 0.8; ctx.fillStyle = col; ctx.fill(); ctx.globalAlpha = 1;
          label(ctx, name, w * x0, by - th + 2, { size: 8.5, color: col, weight: 650 });
        }
        // scanner band
        if (scan > 0 && scan < 1 && vis > 0) {
          const sx = w * (x0 + scan * (x1 - x0));
          const grad = ctx.createLinearGradient(sx - 24, 0, sx, 0);
          grad.addColorStop(0, 'rgba(127,127,127,0)');
          grad.addColorStop(1, 'rgba(127,127,127,0.18)');
          ctx.fillStyle = grad; ctx.fillRect(sx - 24, h * 0.22, 24, h * 0.46);
          ctx.strokeStyle = theme.text; ctx.globalAlpha = 0.35; ctx.beginPath(); ctx.moveTo(sx, h * 0.22); ctx.lineTo(sx, h * 0.68); ctx.stroke(); ctx.globalAlpha = 1;
        }
        // motif box around the variant
        if (reached) {
          const a = clamp01((s - 2.6) / 0.4) * vis;
          ctx.strokeStyle = C.red; ctx.globalAlpha = a; ctx.lineWidth = 1.2; ctx.setLineDash([3, 3]);
          roundRect(ctx, w * (variantX - 0.045), h * 0.23, w * 0.09, h * 0.45, 5); ctx.stroke();
          ctx.setLineDash([]); ctx.globalAlpha = 1;
          if (a > 0) pill(ctx, w * (variantX + 0.12), h * 0.27, 'TF motif', C.red, '#ffffff', 8, a);
        }
        // gene activity
        const grow = ease(clamp01((s - 4.4) / 1.4)) * vis;
        label(ctx, 'Gene activity', w * x0, h * 0.77, { size: 8.5, weight: 650 });
        const bx = w * 0.32, bmax = w * 0.6, bh = Math.max(7, h * 0.055);
        [['Ref', 0.38, C.blue, 0.83], ['Risk', 0.86, C.red, 0.92]].forEach(([n, v, col, yy]) => {
          const y = h * (yy as number) - bh / 2;
          label(ctx, n as string, bx - 8, y + bh / 2, { size: 8.5, align: 'right' });
          ctx.fillStyle = theme.border; ctx.globalAlpha = 0.5; roundRect(ctx, bx, y, bmax, bh, 3); ctx.fill(); ctx.globalAlpha = 1;
          ctx.fillStyle = col as string; roundRect(ctx, bx, y, Math.max(0.1, bmax * (v as number) * grow), bh, 3); ctx.fill();
        });
      },
    };
  }

  // 5. Cell cross-talk in tissue: start from a whole tissue section, zoom into a region, watch
  //    dendritic cells signal to stem cells, block the signal with an inhibitor, zoom back out.
  function niche(): Scene {
    const r = rng(41);
    // overview: an organic tissue outline filled with tiny cells
    const outline = Array.from({ length: 48 }, (_, i) => {
      const a = (i / 48) * Math.PI * 2;
      const rad = 1 + 0.12 * Math.sin(a * 3 + 0.7) + 0.07 * Math.sin(a * 5 + 2) + (r() - 0.5) * 0.04;
      return [0.5 + Math.cos(a) * 0.38 * rad, 0.4 + Math.sin(a) * 0.3 * rad];
    });
    const inside = (x: number, y: number) => {
      let c = false;
      for (let i = 0, j = outline.length - 1; i < outline.length; j = i++) {
        const [xi, yi] = outline[i], [xj, yj] = outline[j];
        if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) c = !c;
      }
      return c;
    };
    const specks: { x: number; y: number; k: number }[] = [];
    while (specks.length < 260) {
      const x = r(), y = r() * 0.8;
      if (inside(x, y)) specks.push({ x, y, k: r() < 0.06 ? 1 : r() < 0.1 ? 2 : 0 });
    }
    const box = { x: 0.58, y: 0.28, w: 0.2, h: 0.2 }; // region we zoom into (fractions of canvas)

    // zoomed view: packed cells; dendritic cells are plain circles like the rest
    const cols = 14, rows = 7;
    type Cell = { x: number; y: number; kind: 0 | 1 | 2; act: number; links: number[] };
    const cells: Cell[] = [];
    for (let j = 0; j < rows; j++) for (let i = 0; i < cols; i++) {
      cells.push({ x: 0.05 + (i + (j % 2) * 0.5) / (cols - 0.5) * 0.9 + (r() - 0.5) * 0.02, y: 0.08 + (j / (rows - 1)) * 0.62 + (r() - 0.5) * 0.03, kind: 0, act: 0, links: [] });
    }
    const dcs: number[] = [];
    while (dcs.length < 6) { const k = Math.floor(r() * cells.length); if (!dcs.some((d) => Math.hypot(cells[d].x - cells[k].x, cells[d].y - cells[k].y) < 0.22)) dcs.push(k); }
    dcs.forEach((d) => {
      cells[d].kind = 1;
      const near = cells.map((c, i) => [Math.hypot((c.x - cells[d].x) * 1.4, c.y - cells[d].y), i]).filter(([, i]) => cells[i].kind === 0).sort((a, b) => a[0] - b[0]).slice(1, 3);
      near.forEach(([, i]) => { cells[i].kind = 2; cells[d].links.push(i); });
    });
    // stromal cells next to stem cells that can become stem cells while signalling is on
    const stemIdx = cells.map((c, i) => (c.kind === 2 ? i : -1)).filter((i) => i >= 0);
    const candidates = cells
      .map((c, i) => ({ i, d: c.kind === 0 ? Math.min(...stemIdx.map((k) => Math.hypot((cells[k].x - c.x) * 1.4, cells[k].y - c.y))) : 9 }))
      .filter((c) => c.d < 0.16)
      .sort((a, b) => a.d - b.d)
      .slice(0, 16)
      .map((c) => c.i);
    const rank = new Map(candidates.map((i, k) => [i, k]));
    type Sig = { from: number; to: number; born: number; blocked: boolean };
    let sigs: Sig[] = [];
    let next = 0;
    const P = 14;
    return {
      still: 5,
      draw(ctx, w, h, t) {
        const s = t % P;
        const zoom = ease(clamp01((s - 2.0) / 1.3)) * (1 - ease(clamp01((s - 12.4) / 1.3)));
        const inhib = s > 8.2 && s < 11.8;
        const active = zoom > 0.98;
        // stem-cell expansion level: grows with signalling, falls back under the inhibitor
        const expand = reduced ? 0.7 : ease(clamp01((s - 3.6) / 4.2)) * (1 - ease(clamp01((s - 8.4) / 2.4)));
        const extra = expand * candidates.length;

        // overview layer
        if (zoom < 1) {
          const a = 1 - zoom;
          ctx.globalAlpha = a;
          ctx.beginPath();
          outline.forEach(([x, y], i) => (i ? ctx.lineTo(x * w, y * h) : ctx.moveTo(x * w, y * h)));
          ctx.closePath();
          ctx.fillStyle = C.purple; ctx.globalAlpha = 0.14 * a; ctx.fill();
          ctx.strokeStyle = C.purple; ctx.globalAlpha = 0.5 * a; ctx.lineWidth = 1.5; ctx.stroke();
          ctx.globalAlpha = 1;
          for (const p of specks) dot(ctx, p.x * w, p.y * h, 1.4, p.k === 1 ? C.teal : p.k === 2 ? C.orange : theme.muted, (p.k ? 0.9 : 0.4) * a);
          const pulse = 0.5 + 0.5 * Math.sin(t * 4);
          ctx.strokeStyle = theme.text; ctx.globalAlpha = (0.5 + 0.4 * pulse) * a; ctx.lineWidth = 1.5;
          roundRect(ctx, box.x * w, box.y * h, box.w * w, box.h * h, 4); ctx.stroke();
          ctx.globalAlpha = 1;
          label(ctx, 'Bone marrow section', w * 0.05, h * 0.06, { size: 9, weight: 650, color: theme.text });
          if (a > 0.5) label(ctx, 'zoom in', (box.x + box.w + 0.02) * w, (box.y + 0.02) * h, { size: 8.5 });
        }

        // zoomed layer: map the full view from the zoom box (zoom = 0) to the whole canvas (zoom = 1)
        if (zoom > 0) {
          const viewH = h * 0.78;
          const sx = box.w * w / w, sy = box.h * h / viewH;
          const kx = sx + (1 - sx) * zoom, ky = sy + (1 - sy) * zoom;
          const ox = box.x * w * (1 - zoom), oy = box.y * h * (1 - zoom);
          const X = (x: number) => ox + x * w * kx;
          const Y = (y: number) => oy + y * viewH * ky;
          const rad = Math.max(5, Math.min(9, w / 34)) * Math.min(kx, ky);
          ctx.save();
          ctx.beginPath(); ctx.rect(X(0), Y(0), w * kx, viewH * ky); ctx.clip();
          ctx.globalAlpha = zoom;
          ctx.fillStyle = theme.surface; ctx.fillRect(X(0), Y(0), w * kx, viewH * ky);
          ctx.globalAlpha = 1;

          if (!reduced && active && t >= next) {
            const d = dcs[Math.floor(r() * dcs.length)];
            sigs.push({ from: d, to: cells[d].links[Math.floor(r() * cells[d].links.length)], born: t, blocked: inhib });
            next = t + 0.12 + r() * 0.12;
          }
          if (!active) sigs = [];
          for (const c of cells) c.act *= 0.985;

          for (const c of cells) {
            const x = X(c.x), y = Y(c.y);
            if (c.kind === 0) {
              ctx.strokeStyle = theme.border; ctx.lineWidth = 1; ctx.globalAlpha = zoom;
              ctx.beginPath(); ctx.arc(x, y, rad * 0.85, 0, Math.PI * 2); ctx.stroke();
              ctx.globalAlpha = 1;
              dot(ctx, x, y, rad * 0.85, theme.muted, 0.08 * zoom);
              const k = rank.get(cells.indexOf(c));
              if (k !== undefined) {
                const f = clamp01(extra - k); // 0..1: how far this cell has turned into a stem cell
                if (f > 0) dot(ctx, x, y, rad * 0.85 * (0.4 + 0.6 * f) * (inhib ? 0.8 : 1), C.orange, (inhib ? 0.5 : 0.9) * f * zoom);
              }
            } else if (c.kind === 1) {
              dot(ctx, x, y, rad * 0.85, C.teal, zoom);
            } else {
              const glow = Math.min(1, c.act);
              if (glow > 0.05) dot(ctx, x, y, rad * (1.4 + glow * 0.6), C.orange, 0.2 * glow * zoom);
              dot(ctx, x, y, rad * 0.85 * (inhib ? 0.8 : 1), C.orange, (inhib ? 0.5 : 0.95) * zoom);
            }
          }
          sigs = sigs.filter((g) => {
            const k = (t - g.born) / 0.9;
            const a = cells[g.from], b = cells[g.to];
            const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2 - 0.06;
            if (g.blocked && k >= 0.5) {
              if (k > 1.1) return false;
              const [x, y] = bez([a.x, a.y], [mx, my], [mx, my], [b.x, b.y], 0.5);
              const XX = X(x), YY = Y(y), q = 3;
              ctx.strokeStyle = C.red; ctx.lineWidth = 1.5; ctx.globalAlpha = 1 - (k - 0.5) / 0.6;
              ctx.beginPath(); ctx.moveTo(XX - q, YY - q); ctx.lineTo(XX + q, YY + q); ctx.moveTo(XX + q, YY - q); ctx.lineTo(XX - q, YY + q); ctx.stroke();
              ctx.globalAlpha = 1;
              return true;
            }
            if (k >= 1) { b.act += 0.6; return false; }
            const [x, y] = bez([a.x, a.y], [mx, my], [mx, my], [b.x, b.y], k);
            dot(ctx, X(x), Y(y), 2.2, C.teal, 0.95);
            return true;
          });
          ctx.restore();
          ctx.strokeStyle = theme.text; ctx.globalAlpha = 0.5 * (1 - zoom); ctx.lineWidth = 1.5;
          roundRect(ctx, X(0), Y(0), w * kx, viewH * ky, 4); ctx.stroke();
          ctx.globalAlpha = 1;
        }

        // legend + status (cell view only)
        if (zoom > 0.6) {
          const a = (zoom - 0.6) / 0.4;
          ctx.globalAlpha = a;
          const ly = h * 0.86;
          const items: [string, string][] = [['Dendritic cell', C.teal], ['Stem cell', C.orange], ['Stroma', theme.muted]];
          let lx = w * 0.05;
          ctx.font = `500 8.5px ${theme.font}`;
          for (const [n, col] of items) {
            dot(ctx, lx + 3, ly, 3.2, col, (col === theme.muted ? 0.4 : 1) * a);
            label(ctx, n, lx + 10, ly, { size: 8.5 });
            lx += 18 + ctx.measureText(n).width + 6;
          }
          ctx.globalAlpha = 1;
          ctx.globalAlpha = a;
          label(ctx, `Stem cells: ${stemIdx.length + Math.floor(extra)}`, w * 0.95, ly, { size: 8.5, align: 'right', weight: 650, color: C.orange });
          ctx.globalAlpha = 1;
          pill(ctx, w * 0.8, h * 0.95 - 4, inhib ? 'Inhibitor on' : 'Signalling', inhib ? C.red : C.teal, '#ffffff', 8.5, a);
        }
      },
    };
  }

  // 6. Treatment response: each patient has a signature score before treatment (low = green,
  //    high = purple). After treatment, low scorers become transfusion-free; high scorers don't.
  function response(): Scene {
    const r = rng(53);
    const mix = (a: string, b: string, k: number) => {
      const pa = [1, 3, 5].map((i) => parseInt(a.slice(i, i + 2), 16));
      const pb = [1, 3, 5].map((i) => parseInt(b.slice(i, i + 2), 16));
      return `rgb(${pa.map((v, i) => Math.round(v + (pb[i] - v) * k)).join(',')})`;
    };
    const scoreColor = (s: number) => (s < 0.5 ? mix(C.green, '#a9d39f', s / 0.5) : mix('#d8b5cf', C.purple, (s - 0.5) / 0.5));
    // 12 patients with scores; low scores (< 0.5) respond
    const patients = Array.from({ length: 12 }, (_, i) => {
      const score = clamp01(i < 6 ? 0.12 + r() * 0.3 : 0.58 + r() * 0.32);
      return { score, order: r(), responds: score < 0.5 };
    }).sort((a, b) => a.order - b.order);
    patients.forEach((p, i) => Object.assign(p, { col: i % 3, row: Math.floor(i / 3) }));
    const P = 10.5, start = 1.0, stagger = 0.42, travel = 0.9;
    return {
      still: 8.4,
      draw(ctx, w, h, t) {
        const s = t % P;
        const out = ease(clamp01((s - 9.6) / 0.9));
        const vis = 1 - out;

        // score legend
        const gx0 = w * 0.06, gx1 = w * 0.34, gy = h * 0.07;
        label(ctx, 'Signature score', gx0, gy - 1, { size: 8.5, weight: 650 });
        const gb = ctx.createLinearGradient(gx0, 0, gx1, 0);
        gb.addColorStop(0, C.green); gb.addColorStop(0.49, '#a9d39f'); gb.addColorStop(0.51, '#d8b5cf'); gb.addColorStop(1, C.purple);
        ctx.fillStyle = gb; roundRect(ctx, gx0, gy + 7, gx1 - gx0, 5, 2.5); ctx.fill();
        label(ctx, 'low', gx0, gy + 19, { size: 8 });
        label(ctx, 'high', gx1, gy + 19, { size: 8, align: 'right' });

        // columns: before (left), treatment arrow, outcomes (right)
        const leftX = w * 0.2, cell = Math.min(w * 0.075, h * 0.1);
        const gridTop = h * 0.36;
        label(ctx, 'Before', leftX, h * 0.3, { size: 9, weight: 650, color: theme.text, align: 'center' });
        const arrowY = h * 0.56;
        ctx.strokeStyle = theme.border; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(w * 0.36, arrowY); ctx.lineTo(w * 0.52, arrowY); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(w * 0.52, arrowY); ctx.lineTo(w * 0.5, arrowY - 4); ctx.lineTo(w * 0.5, arrowY + 4); ctx.closePath(); ctx.fillStyle = theme.border; ctx.fill();
        pill(ctx, w * 0.44, arrowY - 12, 'treatment', theme.text, theme.surface, 8);

        const boxes = [
          { name: 'Transfusion-free', col: C.green, y: h * 0.24, filled: 0 },
          { name: 'Still transfused', col: C.purple, y: h * 0.6, filled: 0 },
        ];
        const bx = w * 0.56, bw = w * 0.4, bh = h * 0.3;
        for (const b of boxes) {
          ctx.strokeStyle = b.col; ctx.lineWidth = 1.5; ctx.globalAlpha = 0.7;
          roundRect(ctx, bx, b.y, bw, bh, 8); ctx.stroke();
          ctx.globalAlpha = 0.08; ctx.fillStyle = b.col; roundRect(ctx, bx, b.y, bw, bh, 8); ctx.fill();
          ctx.globalAlpha = 1;
          label(ctx, b.name, bx + 8, b.y + 10, { size: 8.5, weight: 650, color: b.col });
        }

        const appear = ease(clamp01(s / 0.6)) * vis;
        patients.forEach((p, i) => {
          const sx = leftX + ((p as any).col - 1) * cell, sy = gridTop + (p as any).row * cell;
          const k = reduced ? 1 : ease(clamp01((s - start - i * stagger) / travel));
          const b = boxes[p.responds ? 0 : 1];
          const n = b.filled++;
          const tx = bx + 16 + (n % 6) * (bw - 26) / 5, ty = b.y + bh * 0.62 + (n >= 6 ? 12 : 0);
          const x = sx + (tx - sx) * k, y = sy + (ty - sy) * k - Math.sin(k * Math.PI) * h * 0.06;
          if (k < 1 && k > 0) dot(ctx, x, y, 7, scoreColor(p.score), 0.12 * appear);
          dot(ctx, x, y, Math.max(3.5, cell * 0.28), scoreColor(p.score), appear);
        });
        const done = clamp01((s - (start + patients.length * stagger + travel)) / 0.5) * vis;
        if (done > 0) {
          ctx.globalAlpha = done;
          label(ctx, 'Low score → responds', w * 0.06, h * 0.93, { size: 9, weight: 650, color: C.green });
          label(ctx, 'High score → doesn’t', w * 0.96, h * 0.93, { size: 9, weight: 650, color: C.purple, align: 'right' });
          ctx.globalAlpha = 1;
        }
      },
    };
  }

  // 7. Clones cell by cell: bulk sequencing gives one blended number; single-cell DNA reveals
  //    which cells carry one hit or two hits on the same gene.
  function clones(): Scene {
    const r = rng(61);
    const cols = 12, rows = 4;
    const cells = Array.from({ length: cols * rows }, (_, i) => {
      const u = r();
      return { col: i % cols, row: Math.floor(i / cols), hits: u < 0.4 ? 0 : u < 0.7 ? 1 : 2 };
    });
    const counts = [0, 1, 2].map((k) => cells.filter((c) => c.hits === k).length);
    const P = 10;
    return {
      still: 7,
      draw(ctx, w, h, t) {
        const s = t % P;
        const out = ease(clamp01((s - 8.9) / 1.0));
        const vis = 1 - out;
        // bulk bar
        label(ctx, 'Bulk sequencing', w * 0.05, h * 0.07, { size: 8.5, weight: 650, color: theme.text });
        const bx = w * 0.05, bw = w * 0.9, bh = Math.max(8, h * 0.05), by = h * 0.11;
        ctx.fillStyle = theme.border; ctx.globalAlpha = 0.6; roundRect(ctx, bx, by, bw, bh, 4); ctx.fill(); ctx.globalAlpha = 1;
        const fill = ease(clamp01(s / 0.9)) * vis;
        const gb = ctx.createLinearGradient(bx, 0, bx + bw * 0.45, 0);
        gb.addColorStop(0, C.orange); gb.addColorStop(1, C.red);
        ctx.fillStyle = gb; ctx.globalAlpha = 0.7; roundRect(ctx, bx, by, bw * 0.45 * fill, bh, 4); ctx.fill(); ctx.globalAlpha = 1;
        label(ctx, '45% mutant reads, but in which cells?', w * 0.95, h * 0.07, { size: 8.5, align: 'right' });

        // single cells, revealed by a sweep
        label(ctx, 'Single cells (two copies of the gene each)', w * 0.05, h * 0.27, { size: 8.5, weight: 650, color: theme.text });
        const gx0 = w * 0.07, gx1 = w * 0.93, gy0 = h * 0.35, gy1 = h * 0.63;
        const rad = Math.min((gx1 - gx0) / cols, (gy1 - gy0) / rows) * 0.36;
        const sweep = reduced ? 1 : clamp01((s - 1.1) / 3.6);
        const tally = [0, 0, 0];
        const hitColor = [theme.muted, C.orange, C.red];
        for (const c of cells) {
          const x = gx0 + (c.col + 0.5) * ((gx1 - gx0) / cols), y = gy0 + (c.row + 0.5) * ((gy1 - gy0) / (rows - 1)) - (gy1 - gy0) / (rows - 1) / 2;
          const shown = (c.col + 0.5) / cols <= sweep;
          if (shown && vis > 0) tally[c.hits]++;
          // outline
          ctx.strokeStyle = theme.border; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.arc(x, y, rad, 0, Math.PI * 2); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(x, y - rad); ctx.lineTo(x, y + rad); ctx.stroke();
          if (!shown) { dot(ctx, x, y, rad, theme.muted, 0.12); continue; }
          const left = c.hits >= 1 ? (c.hits === 2 ? C.red : C.orange) : theme.muted;
          const right = c.hits === 2 ? C.red : theme.muted;
          const a = vis;
          for (const [col, a0, a1, alpha] of [[left, Math.PI / 2, (Math.PI * 3) / 2, c.hits ? 0.95 : 0.2], [right, -Math.PI / 2, Math.PI / 2, c.hits === 2 ? 0.95 : 0.2]] as const) {
            ctx.globalAlpha = alpha * a; ctx.fillStyle = col;
            ctx.beginPath(); ctx.moveTo(x, y); ctx.arc(x, y, rad, a0, a1); ctx.closePath(); ctx.fill();
          }
          ctx.globalAlpha = 1;
        }
        // sweep line
        if (sweep > 0 && sweep < 1 && vis > 0) {
          const sx = gx0 + sweep * (gx1 - gx0);
          ctx.strokeStyle = theme.text; ctx.globalAlpha = 0.35; ctx.beginPath(); ctx.moveTo(sx, gy0 - rad - 4); ctx.lineTo(sx, gy1 + rad - 6); ctx.stroke(); ctx.globalAlpha = 1;
        }
        // tally
        const names = ['No hit', 'One hit', 'Two hits'];
        const tx = w * 0.3, tw = w * 0.62, th = Math.max(6, h * 0.04);
        names.forEach((n, k) => {
          const y = h * (0.75 + k * 0.08);
          label(ctx, n, tx - 8, y + th / 2, { size: 8.5, align: 'right', color: k ? hitColor[k] : theme.muted, weight: 650 });
          ctx.fillStyle = theme.border; ctx.globalAlpha = 0.5; roundRect(ctx, tx, y, tw, th, 3); ctx.fill(); ctx.globalAlpha = 1;
          ctx.fillStyle = hitColor[k]; ctx.globalAlpha = k ? 0.9 : 0.45;
          roundRect(ctx, tx, y, Math.max(0.1, tw * (tally[k] / Math.max(...counts))), th, 3); ctx.fill(); ctx.globalAlpha = 1;
        });
      },
    };
  }

  // 8. Antibodies & infection: B cells around a virus; families whose antibodies bind expand,
  //    and candidate antibodies are collected.
  function antibody(): Scene {
    const r = rng(71);
    const fam = [C.blue, C.teal, C.purple, C.orange];
    const binders = new Set([0, 1]);
    const N = 12;
    const cells = Array.from({ length: N }, (_, i) => {
      const a = (i / N) * Math.PI * 2 + 0.2;
      return { a, f: i % 4, jit: (r() - 0.5) * 0.15 };
    });
    const P = 10.5;
    return {
      still: 6.5,
      draw(ctx, w, h, t) {
        const s = t % P;
        const out = ease(clamp01((s - 9.4) / 1.0));
        const vis = 1 - out;
        const cx = w * 0.5, cy = h * 0.36, vr = Math.min(w, h) * 0.085;
        // virus with spikes
        ctx.strokeStyle = C.red; ctx.lineWidth = 1.6;
        for (let k = 0; k < 12; k++) {
          const a = (k / 12) * Math.PI * 2 + t * 0.15;
          const x0 = cx + Math.cos(a) * vr, y0 = cy + Math.sin(a) * vr;
          const x1 = cx + Math.cos(a) * vr * 1.35, y1 = cy + Math.sin(a) * vr * 1.35;
          ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
          dot(ctx, x1, y1, 2.4, C.red, 1);
        }
        dot(ctx, cx, cy, vr, C.red, 0.18);
        ctx.beginPath(); ctx.arc(cx, cy, vr, 0, Math.PI * 2); ctx.stroke();
        label(ctx, 'virus', cx, cy, { size: 8.5, align: 'center', color: C.red, weight: 650 });

        const bind = ease(clamp01((s - 1.4) / 1.4)) * vis;
        const grow = ease(clamp01((s - 3.2) / 2.2)) * vis;
        const rx = w * 0.34, ry = h * 0.27, cr = Math.max(5, Math.min(8, w / 40));
        const drawB = (x: number, y: number, ang: number, col: string, alpha: number, reach: number) => {
          dot(ctx, x, y, cr, col, alpha);
          // antibody "Y" pointing at the virus
          const dx = Math.cos(ang), dy = Math.sin(ang);
          const stem = cr * 0.9 + reach;
          const sx = x + dx * cr, sy = y + dy * cr, ex = x + dx * stem * 1.6, ey = y + dy * stem * 1.6;
          ctx.strokeStyle = col; ctx.globalAlpha = alpha; ctx.lineWidth = 1.5;
          ctx.beginPath(); ctx.moveTo(sx, sy); ctx.lineTo(ex, ey);
          const arm = cr * 0.7;
          ctx.moveTo(ex, ey); ctx.lineTo(ex + Math.cos(ang - 0.6) * arm, ey + Math.sin(ang - 0.6) * arm);
          ctx.moveTo(ex, ey); ctx.lineTo(ex + Math.cos(ang + 0.6) * arm, ey + Math.sin(ang + 0.6) * arm);
          ctx.stroke(); ctx.globalAlpha = 1;
        };
        for (const c of cells) {
          const x = cx + Math.cos(c.a) * rx * (1 + c.jit), y = cy + Math.sin(c.a) * ry * (1 + c.jit);
          const ang = Math.atan2(cy - y, cx - x);
          const isB = binders.has(c.f);
          const dist = Math.hypot(cx - x, cy - y) - vr * 1.35 - cr * 2.5;
          if (isB && bind > 0.02) dot(ctx, x, y, cr * (1.6 + 0.3 * Math.sin(t * 5)), fam[c.f], 0.15 * bind);
          drawB(x, y, ang, fam[c.f], isB ? 1 : 0.35 + 0.65 * (1 - bind), isB ? dist * bind * 0.55 : 0);
          // clonal expansion: daughters appear beside binders
          if (isB && grow > 0) {
            for (let d = 1; d <= 2; d++) {
              const off = c.a + (d === 1 ? 0.22 : -0.22);
              const dx = cx + Math.cos(off) * rx * (1.18 + c.jit), dy = cy + Math.sin(off) * ry * (1.18 + c.jit);
              dot(ctx, dx, dy, cr * 0.8 * clamp01(grow * 1.5 - (d - 1) * 0.4), fam[c.f], 0.85);
            }
          }
        }
        // candidate antibodies collected below
        const collected = Math.floor(clamp01((s - 5.2) / 2.6) * 8 * vis);
        label(ctx, 'Candidate antibodies', w * 0.05, h * 0.86, { size: 8.5, weight: 650, color: theme.text });
        for (let k = 0; k < 8; k++) {
          const x = w * (0.44 + k * 0.065), y = h * 0.86;
          const col = fam[k % 2];
          ctx.strokeStyle = k < collected ? col : theme.border; ctx.lineWidth = 2;
          ctx.beginPath(); ctx.moveTo(x, y + 6); ctx.lineTo(x, y); ctx.lineTo(x - 4, y - 5); ctx.moveTo(x, y); ctx.lineTo(x + 4, y - 5); ctx.stroke();
        }
      },
    };
  }

  // 9. Reproducible pipelines: samples flow through a workflow; steps light up as they run.
  function pipeline(): Scene {
    const nodes = [
      { name: 'Raw data', x: 0.1, y: 0.42 },
      { name: 'QC', x: 0.29, y: 0.42 },
      { name: 'Align', x: 0.5, y: 0.22 },
      { name: 'Align', x: 0.5, y: 0.62 },
      { name: 'Count', x: 0.71, y: 0.42 },
      { name: 'Report', x: 0.9, y: 0.42 },
    ];
    const edges = [[0, 1], [1, 2], [1, 3], [2, 4], [3, 4], [4, 5]];
    const N = 12, gapT = 0.42, seg = 0.42, dwell = 0.28;
    const routes = Array.from({ length: N }, (_, i) => [0, 1, i % 2 ? 3 : 2, 4, 5]);
    const P = 10.5;
    const total = (routes[0].length - 1) * (seg + dwell);
    return {
      still: 9,
      draw(ctx, w, h, t) {
        const s = t % P;
        const out = ease(clamp01((s - 9.5) / 0.9));
        const vis = 1 - out;
        const X = (n: number) => nodes[n].x * w, Y = (n: number) => nodes[n].y * h;
        // edges
        ctx.strokeStyle = theme.border; ctx.lineWidth = 2;
        for (const [a, b] of edges) {
          const xm = (X(a) + X(b)) / 2;
          ctx.beginPath(); ctx.moveTo(X(a), Y(a)); ctx.bezierCurveTo(xm, Y(a), xm, Y(b), X(b), Y(b)); ctx.stroke();
        }
        // packets
        const busy = new Array(nodes.length).fill(0);
        let done = 0;
        const moving: [number, number][] = [];
        for (let i = 0; i < N; i++) {
          const el = reduced ? total + 1 : s - 0.6 - i * gapT;
          if (el < 0) continue;
          if (el >= total) { done++; continue; }
          const step = Math.floor(el / (seg + dwell)), within = el - step * (seg + dwell);
          const a = routes[i][step], b = routes[i][step + 1];
          if (within < dwell) { busy[a] = 1; continue; }
          const k = ease((within - dwell) / seg);
          const xm = (X(a) + X(b)) / 2;
          const [x, y] = bez([X(a), Y(a)], [xm, Y(a)], [xm, Y(b)], [X(b), Y(b)], k);
          moving.push([x, y]);
        }
        // nodes
        // steps as small circles with labels underneath (leaves the connections free for samples)
        const nr = Math.max(6, Math.min(9, w / 42));
        const rects: number[][] = [];
        nodes.forEach((n, i) => {
          const x = X(i), y = Y(i);
          rects.push([x - nr - 1, y - nr - 1, x + nr + 1, y + nr + 1]);
          if (busy[i]) dot(ctx, x, y, nr + 5, C.teal, 0.18);
          ctx.fillStyle = busy[i] ? C.teal : theme.surface;
          ctx.beginPath(); ctx.arc(x, y, nr, 0, Math.PI * 2); ctx.fill();
          ctx.strokeStyle = busy[i] ? C.teal : theme.muted; ctx.lineWidth = 1.5; ctx.stroke();
          label(ctx, n.name, x, y + nr + 9, { size: 8.5, align: 'center', color: busy[i] ? C.teal : theme.text, weight: 650 });
        });
        // moving samples drawn on top of the step boxes
        moving
          .filter(([x, y]) => !rects.some(([x0, y0, x1, y1]) => x > x0 && x < x1 && y > y0 && y < y1))
          .forEach(([x, y]) => { dot(ctx, x, y, 4.2, theme.surface, vis); dot(ctx, x, y, 3.2, C.teal, vis); });
        // progress
        const px = w * 0.05, pw = w * 0.9, py = h * 0.82, ph = Math.max(6, h * 0.04);
        ctx.globalAlpha = vis;
        label(ctx, `Samples processed ${done}/${N}`, px, py - 9, { size: 8.5, weight: 650, color: theme.text });
        ctx.globalAlpha = 1;
        ctx.fillStyle = theme.border; ctx.globalAlpha = 0.5; roundRect(ctx, px, py, pw, ph, 3); ctx.fill(); ctx.globalAlpha = 1;
        ctx.fillStyle = C.teal; roundRect(ctx, px, py, Math.max(0.1, pw * (done / N) * vis), ph, 3); ctx.fill();
        if (done === N && vis > 0) pill(ctx, w * 0.75, h * 0.93, 'Same result every run ✓', C.green, '#ffffff', 8.5, vis);
      },
    };
  }

  const makers = { clusters, evolution, tree, risk, niche, response, clones, antibody, pipeline } as const;

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-anim]').forEach((canvas) => {
    const kind = canvas.dataset.anim as keyof typeof makers;
    const scene = makers[kind]?.();
    if (!scene) return;
    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0, visible = false, raf = 0, t = scene.still, last = 0;

    const render = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      scene.draw(ctx, w, h, t);
    };
    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width; h = rect.height;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      render();
    };
    const loop = (now: number) => {
      t += Math.min(0.05, (now - last) / 1000);
      last = now;
      render();
      if (visible) raf = requestAnimationFrame(loop);
    };
    const start = () => { if (reduced || raf) return; last = performance.now(); raf = requestAnimationFrame(loop); };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(canvas);
    new MutationObserver(() => { readTheme(); render(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : visible && start()));
    resize();
  });
</script>

<style>
  .ranim {
    margin: -0.4rem -0.4rem 1rem;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  canvas {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
  }
</style>
