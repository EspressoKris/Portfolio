---
// One row per role: dates and place on the left; title, plain-language summary
// and links to the key papers on the right.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { ExperienceItem } from '../data/profile';
import { url } from '../lib/url';

interface Props { items: ExperienceItem[] }
const { items } = Astro.props;

const pubs = new Map((await getCollection('publications')).map((p) => [p.id, p]));
for (const item of items) {
  for (const id of item.papers ?? []) {
    if (!pubs.has(id)) throw new Error(`profile.ts: experience "${item.title}" links to unknown paper "${id}"`);
  }
}
const shortTitle = (t: string) => (t.length > 78 ? t.slice(0, 76).replace(/\s+\S*$/, '') + '…' : t);
---
<ol class="xp">
  {items.map((item) => (
    <li class="xp__row">
      <div class="xp__when">
        <span class="xp__dates">{item.dates}</span>
        <span class="xp__place">{item.place}</span>
        {item.label && <span class="xp__label">{item.label}</span>}
        {item.photo && (
          <Image src={item.photo} alt={item.photoAlt ?? ''} widths={[200, 400]} sizes="200px" class="xp__photo" loading="lazy" />
        )}
      </div>
      <div class="xp__what">
        <h3 class="xp__title">{item.title}</h3>
        <p class="xp__org">{item.org}</p>
        <p class="xp__summary">{item.summary}</p>

        {item.highlights && item.highlights.length > 0 && (
          <Fragment>
            <ul class="xp__projects">
              {item.highlights.slice(0, 2).map((h) => (
                <li>
                  <span class="xp__project-title">{h.title}</span>
                  {h.tag && <span class="xp__tag">{h.tag}</span>}
                  <span class="xp__project-text">{h.text}</span>
                </li>
              ))}
            </ul>
            {item.highlights.length > 2 && (
              <details class="xp__more">
                <summary>{item.highlights.length - 2} more project{item.highlights.length - 2 > 1 ? 's' : ''}</summary>
                <ul class="xp__projects">
                  {item.highlights.slice(2).map((h) => (
                    <li>
                      <span class="xp__project-title">{h.title}</span>
                      {h.tag && <span class="xp__tag">{h.tag}</span>}
                      <span class="xp__project-text">{h.text}</span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </Fragment>
        )}

        {(item.papers?.length || item.links?.length) && (
          <ul class="xp__refs" aria-label="Key work">
            {item.papers?.map((id) => {
              const p = pubs.get(id)!;
              return (
                <li>
                  <a class="xp__ref" href={url(`publications/${p.id}/`)}>
                    <span class="xp__ref-meta">
                      <em>{p.data.venue}</em> · {p.data.date.getFullYear()}
                      {p.data.role === 'First author' && <span class="badge">First author</span>}
                    </span>
                    <span class="xp__ref-title">{shortTitle(p.data.title)}</span>
                  </a>
                </li>
              );
            })}
            {item.links?.map((l) => (
              <li>
                <a class="xp__ref xp__ref--link" href={l.href.startsWith('http') ? l.href : url(l.href)}>
                  <Icon name="book" /> <span class="xp__ref-title">{l.label}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .xp { margin: 0; padding: 0; list-style: none; }

  .xp__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem 2.5rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--border);
  }

  .xp__row:first-child { border-top: 0; padding-top: 0.4rem; }

  @media (min-width: 760px) {
    .xp__row { grid-template-columns: 190px 1fr; }
  }

  .xp__when { display: flex; flex-wrap: wrap; gap: 0.2rem 0.7rem; align-items: baseline; }
  @media (min-width: 760px) { .xp__when { flex-direction: column; flex-wrap: nowrap; align-items: flex-start; gap: 0.2rem; } }
  @media (max-width: 759px) { .xp__when :global(.xp__photo) { flex-basis: 100%; } }

  .xp__dates {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--link);
    font-variant-numeric: tabular-nums;
  }

  .xp__place { font-size: 0.85rem; color: var(--muted); }

  .xp__when :global(.xp__photo) {
    flex: none;
    width: 100%;
    max-width: 200px;
    height: auto;
    aspect-ratio: 3 / 4;
    margin-top: 0.8rem;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 0 0 1px var(--border), var(--shadow);
    filter: var(--img-filter);
  }

  .xp__label {
    align-self: flex-start;
    padding: 0.05rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-text);
    background: var(--accent-soft);
    border-radius: 999px;
  }

  .xp__projects {
    display: grid;
    gap: 0.9rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .xp__projects li {
    position: relative;
    padding-left: 1.1rem;
  }

  .xp__projects li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--accent);
    border-radius: 2px;
    transform: rotate(45deg);
  }

  .xp__project-title { font-weight: 600; color: var(--text); }

  .xp__tag {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.05rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    vertical-align: 0.1em;
    color: var(--link);
    border: 1px solid var(--border);
    border-radius: 999px;
    white-space: nowrap;
  }

  .xp__project-text {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--text-soft);
    max-width: 46em;
  }

  .xp__more { margin-top: 0.9rem; }
  .xp__more summary {
    width: fit-content;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--link);
    cursor: pointer;
    list-style: none;
  }
  .xp__more summary::-webkit-details-marker { display: none; }
  .xp__more summary::before { content: '+ '; }
  .xp__more[open] summary::before { content: '− '; }
  .xp__more[open] summary { margin-bottom: 0.1rem; }

  .xp__title { margin: 0; font-size: 1.12rem; }

  .xp__org { margin: 0.1rem 0 0.7rem; font-size: 0.92rem; color: var(--muted); }

  .xp__summary { margin: 0; max-width: 46em; color: var(--text-soft); }

  .xp__refs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .xp__ref {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 0.7rem 0.85rem;
    color: inherit;
    text-decoration: none;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
  }

  .xp__ref:hover { border-color: var(--link); background: var(--accent-soft); transform: translateY(-2px); }

  .xp__ref--link { flex-direction: row; align-items: center; gap: 0.55rem; color: var(--link); }

  .xp__ref-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--muted);
  }

  .xp__ref-meta em { font-weight: 600; color: var(--text); }

  .xp__ref-meta .badge { font-size: 0.7rem; }

  .xp__ref-title { font-size: 0.86rem; font-weight: 500; line-height: 1.4; color: var(--text); }
  .xp__ref--link .xp__ref-title { color: var(--link); }
</style>
