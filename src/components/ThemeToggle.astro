---
import Icon from './Icon.astro';
---
<button class="theme-toggle" type="button" aria-label="Switch between dark and light mode" title="Dark / light mode">
  <span class="theme-toggle__moon"><Icon name="moon" size="18" /></span>
  <span class="theme-toggle__sun"><Icon name="sun" size="18" /></span>
</button>

<script>
  // Same storage key and attribute as the Starlight tutorials, so the choice carries across.
  const KEY = 'starlight-theme';
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem(KEY, next); } catch {}
      document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
    });
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.3s ease;
  }
  .theme-toggle:hover { color: var(--accent-text); border-color: var(--accent-text); transform: rotate(-15deg); }
  .theme-toggle__sun { display: none; }
  :global([data-theme='dark']) .theme-toggle__sun { display: inline; }
  :global([data-theme='dark']) .theme-toggle__moon { display: none; }
</style>
